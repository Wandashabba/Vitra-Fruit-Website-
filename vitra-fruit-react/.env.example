# Vitra Fruit — Environment Variables
# Copy this file to .env.local for local dev, and add these to Vercel Dashboard > Settings > Environment Variables

# SMTP settings (Gmail for testing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=wandileshaba96@gmail.com
SMTP_PASS=your-gmail-app-password-here

# Where order notification emails are sent
ORDER_EMAIL_TO=wandileshaba96@gmail.com

# PayFast credentials (for ITN verification)
PAYFAST_MERCHANT_ID=your_merchant_id_here
PAYFAST_MERCHANT_KEY=your_merchant_key_here

# Set to 'true' when using PayFast sandbox for testing
PAYFAST_SANDBOX=false

# Mailchimp newsletter integration
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_AUDIENCE_ID=your_audience_id_here

# Admin secret for update-order-status API
ADMIN_SECRET=your_admin_secret_here

# Public site URL (used for email logo attachment)
PUBLIC_SITE_URL=https://vitrafruits.co.za

# Groq API key for Madre AI chatbot (free — no credit card required)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
